# 栖语 (Qiyu) - 环境配置
# 复制为 .env 后修改

# ============================================
# LLM 配置 (x99 llama.cpp OpenAI 兼容 API, 可随时切换任意 OpenAI 兼容后端)
# ============================================
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=sk-no-key-required
LLM_MODEL=your-model-name
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# ============================================
# Letta Agent 配置
# ============================================
LETTA_SERVER_HOST=127.0.0.1
LETTA_SERVER_PORT=8283
LETTA_ADMIN_TOKEN=letta-admin-token-change-me

# ============================================
# Qdrant 向量数据库
# ============================================
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_COLLECTION=companion_memory
QDRANT_RAG_COLLECTION=companion_knowledge

# ============================================
# Embedding 配置 (本地 bge-small-zh)
# ============================================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSION=512

# ============================================
# 适配网关配置
# ============================================
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
GATEWAY_API_KEY=ai-companion-key-change-me

# ============================================
# Open WebUI 配置
# ============================================
OPEN_WEBUI_PORT=8080
OPEN_WEBUI_API_KEY=ai-companion-key-change-me

# ============================================
# 微信配置
# ============================================
WECHAT_ENABLED=false
WECHAT_BOT_NAME=栖语

# ============================================
# RAG 配置
# ============================================
RAG_WATCH_DIR=./data/uploads
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=128
RAG_SCAN_INTERVAL=60

# ============================================
# 记忆配置
# ============================================
MEMORY_SUMMARY_INTERVAL=86400
MEMORY_MAX_CONTEXT=8192

# ============================================
# 数据目录
# ============================================
DATA_DIR=./data
LOGS_DIR=./data/logs
